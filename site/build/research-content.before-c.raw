<!-- wp:divi/text {"module":{"meta":{"adminLabel":{"desktop":{"value":"Introduction Text"}}},"decoration":{"background":{"desktop":{"value":{"image":{"size":"initial","position":"left top","repeat":"repeat"}}}},"layout":{"desktop":{"value":{"display":"block"}}}}},"content":{"decoration":{"headingFont":{"h1":{"font":{"desktop":{"value":{"color":"#800000"}}}}}},"innerContent":{"desktop":{"value":"\u003ch1\u003eResearch\u003c/h1\u003e"}}},"builderVersion":"5.0.0-public-beta.1"} /-->
